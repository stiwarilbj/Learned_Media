{
  "patterns": [
    {
      "kind": "cause",
      "reverse": true,
      "pattern": "\\bcaused?\\s+by\\b"
    },
    {
      "kind": "prevent",
      "reverse": true,
      "pattern": "\\bprevented\\s+by\\b"
    },
    {
      "kind": "cause",
      "reverse": false,
      "pattern": "\\b(?:caused|causing|(?:causes|cause)(?!\\s+of\\b))(?!\\s+by\\b)\\b|\\b(?:led|leads|lead|leading)\\s+to\\b|\\b(?:resulted|results|result|resulting)\\s+in\\b"
    },
    {
      "kind": "cause",
      "reverse": true,
      "pattern": "\\b(?:because of|due to|as a result of)\\b"
    },
    {
      "kind": "prevent",
      "reverse": false,
      "pattern": "\\b(?:prevented|prevents|prevent|preventing)(?!\\s+by\\b)\\b|\\b(?:kept|keeps|keep|keeping|stopped|stops|stop|stopping)\\b(?=[^.;!?]{1,120}\\bfrom\\s+[a-z]+ing\\b)"
    }
  ],
  "stop": "a an the of in on at to for from by with and or but is was were are be been being this that it its his her their had has have who which they he she into through about also did do does not never may might could can would should will must than then very because due as result",
  "uncertain": "\\b(?:may|might|could|would|can|possibly|probably|potentially|hypothesized|suspected|claimed|alleged|suggested|proposed|whether|if|intended|designed|aimed|planned|expected)\\b|\\b(?:no evidence|no proof|not established|not proven)\\b",
  "negative": "\\b(?:not|never|failed to|didn't|doesn't|isn't|wasn't)\\b"
}
