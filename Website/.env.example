# Learned Media server configuration
# Copy this file to .env.local and add your own values.

# The key is read only by Next.js server routes. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: choose the model rotation used by the server route.
GEMINI_TEXT_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-pro,gemini-2.5-flash

# Optional Supabase connection for Google OAuth and persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set this when your Supabase project has a different app URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
