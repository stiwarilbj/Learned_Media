# Optional Learned Media server configuration for Google sign-in.
# Gemini keys are entered in Settings and are never stored in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set this when your Supabase project has a different app URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
